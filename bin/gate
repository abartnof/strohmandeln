#!/usr/bin/env bash
# The gate before every commit: formatting, lints, tests. It prints one
# summary line and exits non-zero on any failure. Never pipe it (`| tail`
# would hide its status): run it bare, as `bin/gate || exit 1`.
#
# Adapted from cassino's bin/gate @ 73f0cd7. What it runs, when it exists:
#   - cargo fmt --check, clippy -D warnings, cargo test   (a Cargo.toml at the root)
#   - node --test over kit/test and web3d/test            (those folders)
#   - python3 -m unittest over kit/test                   (the kit's build.py tests)
#   - the phrase bank's tests and tools/phrases.py --check (tools/)
#   - kit/build.py --check                                (the game's page)
# Unlike cassino's, it does not skip the Node tests when web3d/node_modules is
# missing: the kit imports `three` from there, so a missing install is a
# failure that says how to fix it (kit/README.md).
set -euo pipefail
cd "$(dirname "$0")/.."
[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
parts=()

fail() {
  echo "gate: FAILED: $1" >&2
  exit 1
}

# ---- Rust --------------------------------------------------------------
if [ -f Cargo.toml ]; then
  command -v cargo >/dev/null || fail "Cargo.toml exists but cargo is not installed"
  cargo fmt --all -- --check >/dev/null 2>&1 || fail "cargo fmt (run cargo fmt)"
  if ! out=$(cargo clippy --all-targets --quiet -- -D warnings 2>&1); then
    echo "$out" | head -40 >&2
    fail "clippy"
  fi
  if ! out=$(cargo test --quiet 2>&1); then
    echo "$out" | grep -E "FAILED|panicked|error" | head -40 >&2
    fail "cargo test"
  fi
  rust_passed=$(echo "$out" | grep -oE "test result: ok\. [0-9]+ passed" | awk '{s += $4} END {print s + 0}')
  parts+=("$rust_passed in Rust")
else
  parts+=("no Cargo.toml, Rust skipped")
fi

# ---- The kit's stamp: every file it lists is there ---------------------
if [ -f kit/STAMP ]; then
  while read -r file; do
    [ -e "kit/$file" ] || fail "kit/STAMP lists kit/$file, which is missing"
  done < <(awk '/^files:/ {on = 1; next} on && NF {print $1}' kit/STAMP)
fi

# ---- Node: the kit's tests and the game's ------------------------------
dirs=()
[ -d kit/test ] && dirs+=(kit/test)
[ -d web3d/test ] && dirs+=(web3d/test)
if [ ${#dirs[@]} -gt 0 ]; then
  [ -d web3d/node_modules/three ] || fail "web3d/node_modules is missing: run npm ci in web3d/ (the kit imports three from there)"
  [ -e kit/node_modules/three ] || fail "kit/node_modules does not lead to web3d/node_modules (it should be a symlink to ../web3d/node_modules)"
  if ! node_out=$(node --test "${dirs[@]/%//}" 2>&1); then
    echo "$node_out" | grep -E "^not ok|^\s+not ok|Error|expected|actual" | head -40 >&2
    fail "node tests"
  fi
  parts+=("$(echo "$node_out" | grep -oE "^# pass [0-9]+" | awk '{print $3}') in Node")
else
  parts+=("no node tests")
fi

# ---- Python: the kit's build.py ----------------------------------------
if ls kit/test/test_*.py >/dev/null 2>&1; then
  if ! py_out=$(python3 -m unittest discover -s kit/test -p 'test_*.py' 2>&1); then
    echo "$py_out" | tail -30 >&2
    fail "python tests (kit/build.py)"
  fi
  parts+=("$(echo "$py_out" | grep -oE "^Ran [0-9]+" | awk '{print $2}') in Python")
fi

# ---- Python: the phrase bank (its rules, and generated files kept current)
if [ -f tools/phrases.py ]; then
  if ! ph_out=$(cd tools && python3 -m unittest discover -s . -p 'test_*.py' 2>&1); then
    echo "$ph_out" | tail -30 >&2
    fail "phrase bank tests (tools/)"
  fi
  python3 tools/phrases.py --check >/dev/null 2>&1 || fail "the phrase bank's generated files are stale (run python3 tools/phrases.py)"
  parts+=("$(echo "$ph_out" | grep -oE "^Ran [0-9]+" | awk '{print $2}') in the phrase bank")
fi

# ---- The page: it must be built from these sources (the build is deterministic)
if [ -f web3d/game.toml ]; then
  page=$(python3 kit/build.py --output-path)
  if [ -f "$page" ]; then
    if ! out=$(python3 kit/build.py --check 2>&1); then
      echo "$out" | tail -3 >&2
      fail "the built page is stale"
    fi
    # Built but not staged: the gate usually runs before staging, so on its own
    # that is a note. But when the page's sources are staged and the rebuilt
    # page is not, `git commit` would leave the page behind, stale: that fails.
    if ! git diff --quiet -- "$page"; then
      if ! git diff --cached --quiet -- web3d/src kit crates; then
        fail "$page is rebuilt but not staged, and the sources it is built from are (git add $page)"
      fi
      echo "gate: note: $page is rebuilt but not staged" >&2
    fi
    parts+=("page current")
  else
    parts+=("page not built yet, check skipped")
  fi
else
  parts+=("no web3d/game.toml, page check skipped")
fi

summary=$(IFS=';'; echo "${parts[*]}")
echo "gate: ok (${summary//;/; })"
